# ==============================================================================
# NHVet411 Environment Configuration
# Copy this file to `.env` for local scripts (seed_supabase.js / extract_and_enrich.js).
# NEVER commit `.env` or real API keys to GitHub.
# ==============================================================================

# Supabase Project Credentials (Project Settings -> API)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Google Gemini API Key (set ONLY as a Supabase Edge Function secret — NEVER commit to GitHub or expose in browser)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Optional: Public Supabase Edge Function URL baked into index.html during Cloudflare Pages/Vercel build
# (Automatically derived from SUPABASE_URL if omitted)
NHVET411_GEMINI_PROXY_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/gemini-search-proxy

# Optional: Comma-separated allowed origins set as a Supabase Edge Function secret in production
ALLOWED_ORIGINS=https://nhvet411.org,https://www.nhvet411.org
